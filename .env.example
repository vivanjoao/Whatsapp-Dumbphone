# Required: replace placeholders before starting.
PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
# Optional: empty disables bookmark authentication. Generate: openssl rand -hex 16
ACCESS_TOKEN=
# true preserves navigation on phones without cookies; false exchanges token for cookie.
LEGACY_TOKEN_URLS=true
# Set true for HTTPS deployments. Old HTTP-only phones require a private trusted network.
COOKIE_SECURE=false
# Only when behind a reverse proxy: trusted proxy IPs/CIDRs, comma separated.
# TRUST_PROXY=loopback
# AUTH_DIR=.wwebjs_auth
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
