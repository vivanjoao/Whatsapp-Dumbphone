# Replace both placeholders before starting. Do not reuse example values.
PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
# Optional; empty disables bookmarks. Generate with: openssl rand -hex 16
ACCESS_TOKEN=
# true: navigation without cookies; false: exchange bookmark for a cookie.
LEGACY_TOKEN_URLS=true
# true behind HTTPS; false only for local/private HTTP testing.
COOKIE_SECURE=false
BIND_ADDR=0.0.0.0:3000
DATA_DIR=./data
# Admission limits, per account/process (not number of WhatsApp accounts).
MAX_REQUESTS=64
MAX_SENDS=4
